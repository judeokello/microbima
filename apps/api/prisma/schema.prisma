model MessagingDelivery {
  id          String          @id @default(uuid()) @db.Uuid
  templateKey String          @db.VarChar(100)
  channel     MessagingChannel

  customerId String? @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  policyId String? @db.Uuid
  policy   Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  recipientPhone String? @db.VarChar(20)
  recipientEmail String? @db.VarChar(200)

  requestedLanguage String @db.VarChar(5)
  usedLanguage      String? @db.VarChar(5)

  renderedSubject  String? @db.VarChar(500)
  renderedBody     String  @db.Text
  renderedTextBody String? @db.Text

  // Render/processing errors (operator-visible)
  errorMessage          String?  @db.VarChar(500)
  missingPlaceholderKeys String[]
  renderError           String?  @db.Text
  lastError             String?  @db.Text

  status       MessagingDeliveryStatus @default(PENDING)
  attemptCount Int                    @default(0)
  maxAttempts  Int
  nextAttemptAt DateTime? @db.Timestamptz
  lastAttemptAt DateTime? @db.Timestamptz

  providerMessageId String? @db.VarChar(200)
  correlationId     String? @db.VarChar(100)

  // Resend tracing
  originalDeliveryId String? @db.Uuid
  originalDelivery   MessagingDelivery? @relation("DeliveryResendTrace", fields: [originalDeliveryId], references: [id], onDelete: SetNull)
  resends            MessagingDelivery[] @relation("DeliveryResendTrace")

  // Dynamic attachment generation: [{ attachmentTemplateId, params }]. Cleared after PDFs are generated.
  dynamicAttachmentSpecs Json?

  /// Placeholder key/value map from enqueue(); merged at render time with customer defaults (worker).
  enqueuePlaceholderContext Json?

  /// Admin campaign this delivery belongs to (null for transactional messages).
  campaignId String? @db.Uuid
  campaign   MessagingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Provider API accepted the send (handoff).
  handedOffAt DateTime? @db.Timestamptz
  /// Provider delivery receipt confirmed (SMS webhook; email often unset).
  receiptConfirmedAt DateTime? @db.Timestamptz

  attachments   MessagingAttachment[]
  providerEvents MessagingProviderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([status, nextAttemptAt], name: "idx_messaging_delivery_status_next_attempt")
  @@index([customerId, createdAt], name: "idx_messaging_delivery_customer_created")
  @@index([policyId, createdAt], name: "idx_messaging_delivery_policy_created")
  @@index([providerMessageId], name: "idx_messaging_delivery_provider_message_id")
  @@index([campaignId, status], name: "idx_messaging_delivery_campaign_status")
  @@index([campaignId, createdAt], name: "idx_messaging_delivery_campaign_created")
  @@map("messaging_deliveries")
}

